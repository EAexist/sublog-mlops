# Required env vars — no secrets. Copy to .env and fill in API keys.
# Airflow Connections are seeded from these (see make airflow-seed).

# OpenAI (for oracle + openai_client)
OPENAI_API_KEY=

# Google (for gemini_client)
GOOGLE_API_KEY=

# Optional: MLflow tracking (default local ./mlruns)
# MLFLOW_TRACKING_URI=

# Optional: Airflow (when running CLI locally)
# AIRFLOW_HOME=./airflow_home
