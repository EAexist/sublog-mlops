# Required env vars. Copy to .env and fill in API keys.

# HuggingFace
HF_TOKEN=

## Models

# GROQ (for oracle)
GROQ_API_KEY=

# OpenAI (for openai_client)
OPENAI_API_KEY=

# Google (for gemini_client)
GOOGLE_API_KEY=

# Optional: MLflow tracking (default local ./mlruns)
# MLFLOW_TRACKING_URI=

# Optional: Airflow (when running CLI locally)
# AIRFLOW_HOME=./airflow_home
LITELLM_LOG=DEBUG